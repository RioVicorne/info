---
// Experience.astro
interface ExperienceItem {
  role: string;
  company: string;
  period: string;
  description: string;
}

const experiences: ExperienceItem[] = [
  {
    role: "Senior Full-Stack Engineer",
    company: "@ Global Tech",
    period: "2023 — Hiện tại",
    description: "Phụ trách kiến trúc Frontend nền tảng, hệ thống Design System chung và thiết kế API microservices phục vụ hơn 500k người dùng hàng tháng."
  },
  {
    role: "Creative Front-End Developer",
    company: "@ Digital Agency",
    period: "2021 — 2023",
    description: "Phát triển các landing page tương tác 3D với WebGL/Three.js và tối ưu hóa trải nghiệm tải trang SPA đạt điểm tuyệt đối 99+ trên Lighthouse."
  },
  {
    role: "Software Engineer",
    company: "@ Fintech Lab",
    period: "2019 — 2021",
    description: "Xây dựng bảng điều khiển dữ liệu tài chính thời gian thực, tích hợp cổng thanh toán bảo mật và tối ưu truy vấn cơ sở dữ liệu quy mô lớn."
  }
];
---

<section class="section" id="experience">
  <div class="section-header">
    <h2 class="section-title">Experience</h2>
  </div>
  <div class="experience-list">
    {experiences.map((exp) => (
      <div class="experience-item">
        <div class="exp-top">
          <span class="exp-role">
            {exp.role} <span class="exp-company">{exp.company}</span>
          </span>
          <span class="exp-time">{exp.period}</span>
        </div>
        <p class="exp-desc">{exp.description}</p>
      </div>
    ))}
  </div>
</section>
