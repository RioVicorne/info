---
// Projects.astro
interface ProjectItem {
  title: string;
  tags: string[];
  description: string;
  link: string;
}

const projects: ProjectItem[] = [
  {
    title: "Pulse Analytics SaaS",
    tags: ["Next.js", "TypeScript", "Tailwind"],
    description: "Nền tảng phân tích số liệu thời gian thực với biểu đồ tương tác, kiến trúc modular widgets và Dark mode tối ưu hóa cho màn hình lớn.",
    link: "https://github.com/RioVicorne"
  },
  {
    title: "Aura Spatial 3D",
    tags: ["Three.js", "GLSL", "Web Audio"],
    description: "Trải nghiệm tương tác 3D WebGL với shader tùy biến, hệ thống hạt ánh sáng động và chuyển động mượt mà 60fps.",
    link: "https://github.com/RioVicorne"
  },
  {
    title: "Nexus API Engine",
    tags: ["Node.js", "Redis", "Docker"],
    description: "Cổng kết nối microservice hiệu năng cao, tích hợp caching phân tán, JWT auth và rate limiting bảo vệ API.",
    link: "https://github.com/RioVicorne"
  },
  {
    title: "Minimalist Notes App",
    tags: ["React", "IndexedDB", "PWA"],
    description: "Ứng dụng ghi chú markdown tinh giản, mã hóa dữ liệu cục bộ, hỗ trợ offline PWA và đồng bộ tức thì.",
    link: "https://github.com/RioVicorne"
  }
];
---

<section class="section" id="projects">
  <div class="section-header">
    <h2 class="section-title">Selected Projects</h2>
  </div>
  <div class="projects-list">
    {projects.map((proj) => (
      <a href={proj.link} target="_blank" rel="noopener noreferrer" class="project-row">
        <div class="project-header">
          <div class="project-title-group">
            <span class="project-title">{proj.title}</span>
            {proj.tags.map((tag) => (
              <span class="project-tag">{tag}</span>
            ))}
          </div>
          <span class="arrow-icon">↗</span>
        </div>
        <p class="project-desc">{proj.description}</p>
      </a>
    ))}
  </div>
</section>
