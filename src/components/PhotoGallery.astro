---
interface PhotoItem {
  title: string;
  location: string;
  src: string;
  alt: string;
}

const photos: PhotoItem[] = [
  { title: 'Cà phê sữa đá & sáng Sài Gòn', location: 'District 1', src: '/images/photo-coffee.svg', alt: 'Minh hoạ một buổi cà phê sáng ở Sài Gòn' },
  { title: 'Vệt hoàng hôn Landmark 81', location: 'Bình Thạnh', src: '/images/photo-city.svg', alt: 'Minh hoạ hoàng hôn và đường chân trời Sài Gòn' },
  { title: 'Góc setup & đêm khuya', location: 'Ở nhà', src: '/images/photo-desk.svg', alt: 'Minh hoạ góc làm việc ban đêm' },
  { title: 'Cuộn phim 35mm', location: 'Đi dạo', src: '/images/photo-film.svg', alt: 'Minh hoạ máy ảnh phim 35mm' }
];
---

<section class="visual-section" id="moments" aria-labelledby="moments-title">
  <div class="section-heading-row">
    <div class="section-marker">
      <span class="section-number">03</span>
      <span class="section-kicker">Những gì mình nhìn thấy</span>
    </div>
    <h2 id="moments-title">Khoảnh<br /><em>khắc</em></h2>
    <p>Vài góc nhỏ đời thường, ghi lại bằng mắt của một người thích đi chậm.</p>
  </div>

  <div class="visual-grid">
    {photos.map((photo, index) => (
      <figure class:list={["visual-item", `visual-item-${index + 1}`]}>
        <div class="visual-image">
          <img src={photo.src} alt={photo.alt} loading="lazy" />
        </div>
        <figcaption>
          <span>{photo.title}</span>
          <small>{photo.location}</small>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
