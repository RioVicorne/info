---
interface Hobby {
  icon: string;
  title: string;
  description: string;
}

const hobbies: Hobby[] = [
  { icon: '01', title: 'Cà phê & đi quán xá', description: 'Tìm những góc yên tĩnh, nhiều cây xanh và một ly pha phin vừa đủ đậm.' },
  { icon: '02', title: 'Nhiếp ảnh đường phố', description: 'Đi bộ thật lâu để bắt gặp vệt nắng, góc phố và màu phim 35mm.' },
  { icon: '03', title: 'Indie & lofi beats', description: 'Một playlist luôn chạy ở phía sau những buổi tối làm việc.' },
  { icon: '04', title: 'UI/UX & những thử nghiệm nhỏ', description: 'Chăm chút những chuyển động nhỏ để giao diện có nhịp điệu và tính cách.' },
  { icon: '05', title: 'Bàn phím cơ & góc setup', description: 'Giữ bàn làm việc gọn, ấm và đủ yên để tập trung.' }
];
---

<section class="hobby-section" id="hobbies" aria-labelledby="hobbies-title">
  <div class="section-marker">
    <span class="section-number">04</span>
    <span class="section-kicker">Những điều giữ mình lại</span>
  </div>
  <div class="hobby-intro">
    <h2 id="hobbies-title">Ngoài <em>màn hình</em></h2>
    <p>Một vài sở thích giúp mình nạp lại năng lượng và nhìn công việc bằng con mắt khác.</p>
  </div>
  <ol class="hobby-list">
    {hobbies.map((item) => (
      <li class="hobby-row">
        <span class="hobby-index">{item.icon}</span>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
        <span class="hobby-arrow" aria-hidden="true">↗</span>
      </li>
    ))}
  </ol>
</section>
