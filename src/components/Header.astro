---
---

<header class="site-header">
  <div class="brand-group">
    <a href="#top" class="brand" aria-label="Về đầu trang">
      <span class="brand-index">KT / 26</span>
      <span class="brand-name">Khoa Tran</span>
    </a>
    <span class="saigon-clock" id="saigon-clock">Saigon · Loading time...</span>
  </div>

  <div class="header-right">
    <nav class="nav-links" aria-label="Điều hướng chính">
      <a href="#about" class="nav-link">Về mình</a>
      <a href="#moments" class="nav-link">Khoảnh khắc</a>
      <a href="#hobbies" class="nav-link">Sở thích</a>
      <a href="#connect" class="nav-link">Liên hệ</a>
    </nav>

    <button class="theme-toggle-btn" id="theme-toggle" aria-label="Đổi giao diện sáng tối" title="Đổi giao diện">
      <svg id="sun-icon" viewBox="0 0 24 24" aria-hidden="true" style="display: block;">
        <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06c.39.39.39 1.03 1.41 0l1.06-1.06zM7.05 18.36c.39.39.39 1.03 0 1.41s-1.03 0-1.41 0l-1.06 1.06c-.39.39-1.03.39-1.41 0s-.39-1.03 0-1.41l1.06-1.06z" />
      </svg>
      <svg id="moon-icon" viewBox="0 0 24 24" aria-hidden="true" style="display: none;">
        <path d="M12.3 2a10 10 0 0 0-.19 20 10.04 10.04 0 0 0 9.95-8.99 1 1 0 0 0-1.25-1.08 8 8 0 0 1-9.6-9.6 1 1 0 0 0-1.08-1.25A10.05 10.05 0 0 0 12.3 2z" />
      </svg>
    </button>
  </div>
</header>

<script>
  function updateSaigonClock() {
    const clockEl = document.getElementById('saigon-clock');
    if (!clockEl) return;
    try {
      const options: Intl.DateTimeFormatOptions = {
        timeZone: 'Asia/Ho_Chi_Minh',
        hour: '2-digit',
        minute: '2-digit',
        hour12: true
      };
      const timeStr = new Intl.DateTimeFormat('en-US', options).format(new Date());
      clockEl.textContent = `Saigon · ${timeStr} (GMT+7)`;
    } catch {
      clockEl.textContent = 'Saigon · GMT+7';
    }
  }

  updateSaigonClock();
  setInterval(updateSaigonClock, 30000);
</script>
