---
// MaintenancePoster.astro — Reusable Permanent Maintenance Poster Component
// ATTENTION AI / DEVELOPER: DO NOT DELETE OR OVERWRITE THIS FILE!
// This is a permanent system component used whenever the site is in maintenance mode.
---

<!-- Force Dark Mode across the entire page -->
<script is:inline>
  document.documentElement.setAttribute('data-theme', 'dark');
  try {
    localStorage.setItem('theme', 'dark');
  } catch (e) {}
</script>

<div class="maintenance-stage">
  <!-- Backdrop subtle dark texture -->
  <div class="dark-grid-bg" aria-hidden="true"></div>

  <div class="poster-box">

    <!-- Top Solid Status Indicator -->
    <div class="status-pill">
      <span class="pulse-indicator"></span>
      <span class="status-text">MAINTENANCE MODE · HỆ THỐNG ĐANG BẢO TRÌ</span>
    </div>

    <!-- Ghostwrite AI shimmer animated text -->
    <div class="fx-shimmer">Website Đang Được Bảo Trì</div>
    
    <div class="meta-row">
      <span class="meta-author">Khoa Tran</span>
      <span class="meta-divider">/</span>
      <span class="meta-handle">@rio_vicorne</span>
      <span class="meta-badge">v2.0 Update</span>
    </div>

    <p class="main-desc">
      Hệ thống đang được nâng cấp toàn diện và tối ưu hóa trải nghiệm người dùng. Website sẽ sớm mở lại trong thời gian ngắn nhất!
    </p>

    <!-- ===================================================================
         VIBRANT MULTI-COLOR LOADING PROCESS (NỔI BẬT & MÀU MÈ)
         =================================================================== -->
    <div class="loading-console">
      
      <!-- Console Top Bar -->
      <div class="console-header">
        <div class="console-title">
          <span class="laser-dot"></span>
          <span>TIẾN TRÌNH NÂNG CẤP HỆ THỐNG</span>
        </div>
        <div class="live-counter" id="live-percent">94%</div>
      </div>

      <!-- High-Energy Glowing Multi-Color Progress Track -->
      <div class="neon-track-wrapper">
        <div class="neon-track">
          <!-- Fluid Multi-Color Glow Bar -->
          <div class="neon-fill">
            <span class="scanner-light"></span>
          </div>
        </div>
      </div>

      <!-- Segmented Multi-Color Cyber Blocks -->
      <div class="cyber-cells" aria-hidden="true">
        <div class="cell cell-cyan active"></div>
        <div class="cell cell-cyan active"></div>
        <div class="cell cell-blue active"></div>
        <div class="cell cell-purple active"></div>
        <div class="cell cell-pink active"></div>
        <div class="cell cell-rose active"></div>
        <div class="cell cell-orange active"></div>
        <div class="cell cell-amber active"></div>
        <div class="cell cell-lime active"></div>
        <div class="cell cell-green pulse-cell"></div>
        <div class="cell cell-dim"></div>
        <div class="cell cell-dim"></div>
      </div>

      <!-- Console Log Line -->
      <div class="console-logs">
        <span class="log-cursor">❯</span>
        <span class="log-text">Đang tinh chỉnh giao diện & tối ưu hiệu năng cuối cùng...</span>
      </div>

    </div>

    <!-- Solid High-Contrast Action Buttons (TikTok & Email Only) -->
    <div class="action-footer">
      <div class="action-hint">Liên hệ trực tiếp với mình qua:</div>

      <div class="buttons-grid">
        <!-- TikTok Button -->
        <a 
          href="https://www.tiktok.com/@rio_vicorne?is_from_webapp=1&sender_device=pc" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="solid-btn btn-tiktok"
          title="TikTok: @rio_vicorne"
        >
          <svg viewBox="0 0 24 24" class="btn-svg">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.29 0 .58.04.86.12V9.42a6.34 6.34 0 0 0-.86-.06 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.75a8.16 8.16 0 0 0 4.77 1.52V6.82a4.85 4.85 0 0 1-1-.13z"/>
          </svg>
          <span class="btn-label">TikTok: <strong>@rio_vicorne</strong></span>
          <span class="btn-arr">↗</span>
        </a>

        <!-- Copy Email Button -->
        <button 
          class="solid-btn btn-email js-copy-email" 
          data-email="khoatran.payment@gmail.com"
          type="button"
          title="Sao chép Email"
        >
          <svg viewBox="0 0 24 24" class="btn-svg">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
          <span class="btn-label">khoatran.payment@gmail.com</span>
          <span class="btn-tag">Copy</span>
        </button>
      </div>
    </div>

    <!-- Solid Footer -->
    <div class="scene-foot">
      <span>Khoa Tran · Sài Gòn 🇻🇳 · Hẹn gặp lại bạn sớm!</span>
    </div>

  </div>
</div>

<!-- Global override: eliminate all white/cream borders and backgrounds on html/body -->
<style is:global>
  /* Colour tokens — override to re-skin the effect:
     --ink    main text colour (defaults to currentColor)
     --ink-2  primary accent   --ink-3  secondary accent */
  :root { 
    --ink: #ffffff; 
    --ink-2: #FF4FD8; 
    --ink-3: #4FF8FF; 
  }

  html, body {
    background-color: #080a0e !important;
    background: #080a0e !important;
    color: #ffffff !important;
    margin: 0 !important;
    padding: 0 !important;
    min-height: 100vh !important;
    width: 100% !important;
    overflow-x: hidden !important;
  }

  body::before {
    display: none !important;
  }

  main.maintenance-main,
  main {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }
</style>

<style>
  /* Base Dark Stage — Pure Solid Colors */
  .maintenance-stage {
    min-height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
    position: relative;
    background-color: #080a0e;
    color: #ffffff;
    box-sizing: border-box;
  }

  .dark-grid-bg {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
  }

  /* Solid Box — No Gradient Washes */
  .poster-box {
    position: relative;
    z-index: 2;
    background-color: #0f141c;
    border: 1px solid #1e2638;
    border-radius: 20px;
    padding: 44px 36px;
    max-width: 580px;
    width: 100%;
    text-align: center;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
    box-sizing: border-box;
  }

  /* Top Solid Pill */
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 9999px;
    background-color: #0b1926;
    border: 1px solid #00f2fe;
    margin-bottom: 24px;
  }

  .pulse-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #00f2fe;
    box-shadow: 0 0 10px #00f2fe;
    animation: solid-blink 1.4s infinite;
  }

  @keyframes solid-blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.3; transform: scale(0.85); }
  }

  .status-text {
    font-family: var(--font-mono, monospace);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #00f2fe;
  }

  /* 82 Ghostwrite — the AI shimmer: a soft luminance band sweeps muted letters */
  .fx-shimmer {
    font: 700 28px/1.25 "JetBrains Mono", monospace;
    letter-spacing: .08em;
    color: transparent;
    background: linear-gradient(90deg,
        color-mix(in srgb, var(--ink) 38%, transparent) 0%,
        color-mix(in srgb, var(--ink) 38%, transparent) 35%,
        color-mix(in srgb, var(--ink) 75%, transparent) 43%,
        #ffffff 50%,
        color-mix(in srgb, var(--ink) 75%, transparent) 57%,
        color-mix(in srgb, var(--ink) 38%, transparent) 65%,
        color-mix(in srgb, var(--ink) 38%, transparent) 100%
      ) 0 0 / 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    animation: fx-shimmer 2.8s linear infinite;
    margin-bottom: 14px;
    word-break: break-word;
  }
  @keyframes fx-shimmer {
    to { background-position: 250% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fx-shimmer {
      animation: none;
      color: var(--ink, #ffffff);
      background: none;
      -webkit-background-clip: initial;
      background-clip: initial;
    }
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.92rem;
    margin-bottom: 18px;
  }

  .meta-author {
    font-weight: 700;
    color: #ffffff;
  }

  .meta-divider {
    color: #334155;
  }

  .meta-handle {
    font-family: var(--font-mono, monospace);
    color: #38bdf8;
    font-weight: 600;
  }

  .meta-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    color: #a855f7;
    background-color: #1a1528;
    border: 1px solid #7c3aed;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 600;
  }

  .main-desc {
    font-size: 0.98rem;
    color: #94a3b8;
    line-height: 1.7;
    margin-bottom: 30px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ===================================================================
     HIGH-ENERGY VIBRANT LOADING CONSOLE
     =================================================================== */
  .loading-console {
    background-color: #090d14;
    border: 1px solid #1e293b;
    border-radius: 14px;
    padding: 18px 20px;
    margin-bottom: 28px;
    text-align: left;
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.6);
  }

  .console-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .console-title {
    font-family: var(--font-mono, monospace);
    font-size: 0.76rem;
    font-weight: 700;
    color: #cbd5e1;
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.04em;
  }

  .laser-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #ff007f;
    box-shadow: 0 0 10px #ff007f, 0 0 20px #ff007f;
    animation: solid-blink 1s infinite alternate;
  }

  .live-counter {
    font-family: var(--font-mono, monospace);
    font-size: 0.92rem;
    font-weight: 800;
    color: #00f2fe;
    text-shadow: 0 0 12px rgba(0, 242, 254, 0.6);
  }

  /* Glowing Multi-Color Progress Track */
  .neon-track-wrapper {
    margin-bottom: 12px;
  }

  .neon-track {
    width: 100%;
    height: 10px;
    background-color: #131b29;
    border-radius: 9999px;
    border: 1px solid #233048;
    overflow: hidden;
    position: relative;
  }

  .neon-fill {
    width: 94%;
    height: 100%;
    border-radius: 9999px;
    position: relative;
    /* Animated multi-color spectrum */
    background: linear-gradient(90deg, #00f2fe, #3b82f6, #a855f7, #ec4899, #f59e0b, #10b981, #00f2fe);
    background-size: 300% 100%;
    animation: spectrum-flow 3.5s linear infinite;
    box-shadow: 0 0 16px rgba(0, 242, 254, 0.6), 0 0 24px rgba(236, 72, 153, 0.4);
  }

  @keyframes spectrum-flow {
    0%   { background-position: 0% 50%; }
    100% { background-position: 300% 50%; }
  }

  /* Laser scanner glide */
  .scanner-light {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 20px;
    background: #ffffff;
    opacity: 0.8;
    box-shadow: 0 0 14px #ffffff, 0 0 25px #00f2fe;
    border-radius: 9999px;
    animation: scanner-flicker 1.5s infinite alternate;
  }

  @keyframes scanner-flicker {
    0%   { opacity: 0.6; transform: scaleX(0.8); }
    100% { opacity: 1; transform: scaleX(1.3); }
  }

  /* Segmented Color Blocks */
  .cyber-cells {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
  }

  .cell {
    flex: 1;
    height: 6px;
    border-radius: 2px;
    background-color: #1e293b;
    transition: all 0.2s ease;
  }

  .cell-cyan   { background-color: #00f2fe; box-shadow: 0 0 8px #00f2fe; }
  .cell-blue   { background-color: #3b82f6; box-shadow: 0 0 8px #3b82f6; }
  .cell-purple { background-color: #a855f7; box-shadow: 0 0 8px #a855f7; }
  .cell-pink   { background-color: #ec4899; box-shadow: 0 0 8px #ec4899; }
  .cell-rose   { background-color: #f43f5e; box-shadow: 0 0 8px #f43f5e; }
  .cell-orange { background-color: #fb923c; box-shadow: 0 0 8px #fb923c; }
  .cell-amber  { background-color: #f59e0b; box-shadow: 0 0 8px #f59e0b; }
  .cell-lime   { background-color: #84cc16; box-shadow: 0 0 8px #84cc16; }
  .cell-green  { background-color: #10b981; box-shadow: 0 0 8px #10b981; }

  .pulse-cell {
    animation: cell-pulse 1s infinite alternate;
  }

  @keyframes cell-pulse {
    0%   { opacity: 0.3; }
    100% { opacity: 1; filter: brightness(1.4); }
  }

  .cell-dim {
    background-color: #1e2638;
  }

  /* Log text */
  .console-logs {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono, monospace);
    font-size: 0.76rem;
    color: #64748b;
  }

  .log-cursor {
    color: #00f2fe;
    font-weight: bold;
    animation: solid-blink 0.8s infinite;
  }

  .log-text {
    color: #94a3b8;
  }

  /* Solid Action Buttons (No Gradient) */
  .action-footer {
    border-top: 1px solid #1e2638;
    padding-top: 22px;
    margin-bottom: 20px;
  }

  .action-hint {
    font-size: 0.84rem;
    color: #64748b;
    margin-bottom: 14px;
    font-weight: 500;
  }

  .buttons-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .solid-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 18px;
    border-radius: 12px;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .btn-svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
    flex-shrink: 0;
  }

  /* Solid TikTok Button: Pure black background with solid cyan border */
  .btn-tiktok {
    background-color: #090c10;
    border: 1px solid #00f2fe;
    color: #ffffff;
  }

  .btn-tiktok:hover {
    background-color: #00f2fe;
    color: #090c10;
    box-shadow: 0 0 20px rgba(0, 242, 254, 0.4);
    transform: translateY(-2px);
  }

  .btn-arr {
    color: #00f2fe;
    font-size: 1rem;
    margin-left: 2px;
  }

  .btn-tiktok:hover .btn-arr {
    color: #090c10;
  }

  /* Solid Email Button: Pure black background with solid hot pink border */
  .btn-email {
    background-color: #090c10;
    border: 1px solid #ec4899;
    color: #ffffff;
  }

  .btn-email:hover {
    background-color: #ec4899;
    color: #090c10;
    box-shadow: 0 0 20px rgba(236, 72, 153, 0.4);
    transform: translateY(-2px);
  }

  .btn-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    background-color: #241320;
    color: #f472b6;
    border: 1px solid #ec4899;
    padding: 2px 7px;
    border-radius: 4px;
    margin-left: auto;
  }

  .btn-email:hover .btn-tag {
    background-color: #ffffff;
    color: #ec4899;
  }

  .scene-foot {
    font-size: 0.78rem;
    color: #475569;
    margin-top: 14px;
  }

  @media (max-width: 600px) {
    .poster-box {
      padding: 30px 18px;
    }
    .fx-shimmer {
      font-size: 21px;
      letter-spacing: .08em;
    }
  }
</style>
